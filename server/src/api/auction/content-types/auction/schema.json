{
  "kind": "collectionType",
  "collectionName": "auctions",
  "info": {
    "singularName": "auction",
    "pluralName": "auctions",
    "displayName": "Auction"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "title": {
      "type": "string"
    },
    "displayStatus": {
      "type": "enumeration",
      "enum": [
        "live",
        "completed"
      ],
      "default": "live"
    },
    "tournament": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::tournament.tournament",
      "inversedBy": "auctions"
    },
    "player": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::player.player"
    }
  }
}
